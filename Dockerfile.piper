FROM python:3.13.11-slim

# Copy uv from the official image.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# System dependencies for Piper.
RUN apt-get update && apt-get install -y --no-install-recommends \
    espeak-ng \
    ffmpeg \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/app

# Create a directory for models and voices.
RUN mkdir -p /opt/app/piper-models

# Copy dependency metadata for better caching.
COPY pyproject.toml ./
COPY uv.lock ./

# Install dependencies ONLY (skips installing the local project).
# --no-editable: do not install the project as editable.
# --no-dev: exclude development dependencies.
# --no-install-project: do not install the root project, but install its dependencies.
RUN uv sync --frozen --no-dev --no-editable --no-install-project

ENV PATH="/opt/app/.venv/bin:$PATH"

# Copy the Piper server.
COPY piper-server.py ./

# Expose the port.
EXPOSE 8000

# Run the FastAPI server with unbuffered output to view logs.
CMD ["python", "-u", "piper-server.py"]
