# Discord TTS Bot Configuration

# Path to store config and data (subdirectories config/ and data/ will be created)
DISCORD_TTS_CONFIG=/data/discord-tts

# Discord bot token (get it from https://discord.com/developers/applications)
DISCORD_TOKEN=your-discord-bot-token-here

# TTS provider type (level or google)
DISCORD_PROVIDER_TYPE=level

# Enable TTS in specific channels
DISCORD_ENABLE_TTS_CHANNELS=false

# Docker image to use
DISCORD_TTS_IMAGE=moonstarx/discord-tts-bot:4.2.0

# Timezone
TZ=America/Guayaquil
